# ========================================
# SMART EDU CRM - Environment Variables
# ========================================
# Bu faylni .gitignore ga qo'shing!
# Production uchun o'z qiymatlaringizni kiriting

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1

# Database
# SQLite uchun USE_POSTGRES=False qoldiring
# PostgreSQL uchun USE_POSTGRES=True qiling va quyidagilarni to'ldiring
USE_POSTGRES=True

# PostgreSQL sozlamalari (USE_POSTGRES=True bo'lganda ishlatiladi)
DB_NAME=crmtizim_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
PG_DUMP_PATH=/usr/bin/pg_dump

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_REDIS=True

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BACKUP_CHAT_ID=your_chat_id_here

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# SMS Provider (Eskiz.uz)
SMS_API_URL=https://notify.eskiz.uz/api
SMS_EMAIL=your_email@example.com
SMS_PASSWORD=your_password

# CORS (Mobil ilova uchun)
CORS_ALLOWED_ORIGINS=https://app.smartedu.uz,https://admin.smartedu.uz

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn_here

# AWS S3 (Media files uchun, ixtiyoriy)
USE_S3=False
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_STORAGE_BUCKET_NAME=your_bucket
AWS_S3_REGION_NAME=us-east-1
