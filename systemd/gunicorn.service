[Unit]
Description=Crmtizim Gunicorn daemon
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/Crmtizim
EnvironmentFile=/var/www/Crmtizim/.env
ExecStart=/var/www/Crmtizim/venv/bin/gunicorn \
    --config /var/www/Crmtizim/gunicorn_config.py \
    config.wsgi:application

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
